# Motion configuration (non-secret examples)
#
# Copy to `.env` and adjust. Never commit real secrets.

# --- Application ------------------------------------------------------------
APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080

# --- Sessions & cookies -----------------------------------------------------
SESSION_TTL=24h
SESSION_IDLE_TTL=2h
# Leave unset to auto-enable in production (APP_ENV=production). Force with true/false.
SECURE_COOKIES=false

# --- CORS / proxies ---------------------------------------------------------
# Comma-separated list of trusted browser origins (scheme://host[:port]).
TRUSTED_ORIGINS=
# Comma-separated list of reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted
# for rate limiting. Leave empty when not behind a proxy.
TRUSTED_PROXIES=

# --- Rate limits (requests per window) --------------------------------------
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RESET=3
RATE_LIMIT_VERIFY=5
RATE_LIMIT_UPLOAD=30

# --- Email (SMTP) -----------------------------------------------------------
# If SMTP_HOST is empty, password-reset and verification emails are not sent.
# In development, set DEV_EMAIL_OUTBOX=true to write them to data/outbox.log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Email verification -----------------------------------------------------
# When true, new accounts must verify their email before uploading/processing.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL=24h
# Dev only: log outgoing mail to <MOTION_DATA_DIR>/outbox.log. Never enable in production.
DEV_EMAIL_OUTBOX=true

# --- Storage locations ------------------------------------------------------
# Relative paths resolve against the process working directory.
MOTION_DATA_DIR=data
MOTION_UPLOAD_DIR=uploads
MOTION_OUTPUT_DIR=outputs
# Defaults to <MOTION_DATA_DIR>/tmp when empty.
MOTION_TEMP_DIR=
# Derived editor previews (thumbnail filmstrips, waveform peaks).
# Defaults to <MOTION_DATA_DIR>/previews when empty. Safe to delete at any time.
MOTION_PREVIEW_DIR=

# --- Encryption at rest -----------------------------------------------------
# Base64-encoded 32-byte master key. Generate with: openssl rand -base64 32
# Leave empty to disable encryption. Files uploaded while enabled are encrypted;
# run `motion encrypt-media` / `motion decrypt-media` to migrate existing files.
MOTION_ENCRYPTION_KEY=

# --- Retention / cleanup ----------------------------------------------------
RETENTION=24h
CLEANUP_INTERVAL=1h

# --- Upload validation ------------------------------------------------------
MAX_UPLOAD_BYTES=157286400
MAX_DURATION_SECONDS=300
MAX_WIDTH=1920
MAX_HEIGHT=1080

# --- Quotas & resource limits ----------------------------------------------
MAX_ACTIVE_UPLOADS_PER_USER=3
MAX_SOURCE_FILES_PER_USER=50
MAX_OUTPUTS_PER_USER=200
# 5 GiB
MAX_STORED_BYTES_PER_USER=5368709120
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_GLOBAL_CONCURRENT_JOBS=3
# 50 GiB
MAX_TOTAL_STORAGE_BYTES=53687091200
# Refuse new uploads when free disk drops below this (fail-open if statfs fails).
MIN_FREE_DISK_BYTES=1073741824
