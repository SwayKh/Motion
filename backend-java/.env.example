# Motion (Java) configuration template. Copy to `.env` next to your Compose file
# and fill in real values. NEVER commit real secrets: this file contains
# placeholders only. The application never reads `.env` itself; Compose passes
# the variables through `env_file`.

# --- Application ------------------------------------------------------------
APP_ENV=production
SPRING_PROFILES_ACTIVE=production
PORT=8080
# Public HTTPS URL of your deployment (used in emails and cookie/origin logic).
BASE_URL=https://motion.example.com
# Set true only for an explicitly exposed development instance.
SPRINGDOC_ENABLED=false

# --- Database ---------------------------------------------------------------
# Leave MOTION_JDBC_URL unset: the default is jdbc:sqlite:${MOTION_DATA_DIR}/app.db
# with WAL journaling and a 5s busy timeout. Motion is a single-instance
# application; do not point multiple instances at one database.
# MOTION_JDBC_URL=jdbc:sqlite:/app/data/app.db?busy_timeout=5000&journal_mode=WAL
MOTION_DB_POOL_SIZE=1
MOTION_FLYWAY_ENABLED=true

# --- Sessions & cookies -----------------------------------------------------
SESSION_TTL=24h
SESSION_IDLE_TTL=2h
# true in production (behind HTTPS). The Docker image forces this already.
SECURE_COOKIES=true

# --- CORS / proxies ---------------------------------------------------------
# Comma-separated browser origins allowed to make credentialed requests.
# Include the port when the browser sends one, e.g. https://motion.example.com
TRUSTED_ORIGINS=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for rate
# limiting. Set this to your reverse proxy's address when running behind one.
TRUSTED_PROXIES=

# --- Rate limits (per client IP per window) ----------------------------------
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RESET=3
RATE_LIMIT_VERIFY=5
RATE_LIMIT_UPLOAD=30

# --- Email / SMTP -----------------------------------------------------------
# Leave SMTP_HOST empty to disable delivery. With Gmail use an App Password
# (Google Account → Security → 2-Step Verification → App passwords),
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your address>,
# SMTP_PASS=<app password>, SMTP_FROM=<your address>.
# Never enable DEV_EMAIL_OUTBOX in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL=24h
DEV_EMAIL_OUTBOX=false

# --- Storage ----------------------------------------------------------------
# Container paths; keep in sync with the Compose volume mounts.
MOTION_DATA_DIR=/app/data
MOTION_UPLOAD_DIR=/app/uploads
MOTION_OUTPUT_DIR=/app/outputs
MOTION_TEMP_DIR=
MOTION_PREVIEW_DIR=
MOTION_MULTIPART_MAX_FILE_SIZE=150MB
MOTION_MULTIPART_MAX_REQUEST_SIZE=150MB

# --- Encryption at rest -----------------------------------------------------
# Optional but strongly recommended. Generate with:  openssl rand -base64 32
# Media is encrypted with AES-256-GCM (MOTIONE1 chunked format). An invalid
# key aborts startup. KEEP A COPY IN YOUR BACKUP: without the key, encrypted
# media is permanently unreadable. There is no built-in key rotation.
MOTION_ENCRYPTION_KEY=

# --- Retention / cleanup ----------------------------------------------------
# Terminal videos older than RETENTION are deleted with their media.
RETENTION=24h
CLEANUP_INTERVAL=1h

# --- Upload validation ------------------------------------------------------
MAX_UPLOAD_BYTES=157286400
MAX_DURATION_SECONDS=300
MAX_WIDTH=1920
MAX_HEIGHT=1080

# --- Quotas & resource limits -----------------------------------------------
MAX_ACTIVE_UPLOADS_PER_USER=3
MAX_SOURCE_FILES_PER_USER=50
MAX_OUTPUTS_PER_USER=200
MAX_STORED_BYTES_PER_USER=5368709120
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_GLOBAL_CONCURRENT_JOBS=3
MAX_TOTAL_STORAGE_BYTES=53687091200
MIN_FREE_DISK_BYTES=1073741824

# --- Async job workers ------------------------------------------------------
# SQLite is the durable queue. Workers claim jobs atomically with lease tokens;
# interrupted jobs are requeued automatically on startup.
MOTION_JOB_WORKERS=3
MOTION_JOB_QUEUE_CAPACITY=100
MOTION_MAX_QUEUED_JOBS=200
MOTION_JOB_POLL_INTERVAL=2s
MOTION_JOB_PROGRESS_INTERVAL=500ms
MOTION_JOB_SHUTDOWN_TIMEOUT=30s
# Hard wall-clock limit for a single FFmpeg execution (default 2h).
MOTION_FFMPEG_TIMEOUT=2h
