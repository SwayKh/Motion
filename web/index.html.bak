<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="CineCut Studio — a local video processing dashboard powered by Go and FFmpeg."
    />
    <title>CineCut Studio — Video Processing</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <rect x="3" y="7" width="26" height="18" rx="3" stroke="currentColor" stroke-width="1.6" />
            <path d="M12 12.5v7l6-3.5-6-3.5Z" fill="currentColor" />
          </svg>
        </div>
        <div class="brand-copy">
          <span class="brand-name">CINE<span>CUT</span></span>
          <span class="brand-sub">Video processing studio</span>
        </div>
      </div>

      <div class="topbar-actions">
        <div class="backend-status" id="backendStatus" data-state="checking" title="Backend connection">
          <span class="status-dot" aria-hidden="true"></span>
          <span id="backendStatusText">Checking backend…</span>
        </div>
        <button class="btn btn-ghost" id="refreshBtn" type="button">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M16.5 8A6.5 6.5 0 1 0 17 12" stroke-linecap="round" />
            <path d="M16.5 3.5V8H12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Refresh library</span>
        </button>
      </div>
    </header>

    <main class="app">
      <aside class="sidebar">
        <section class="sidebar-section upload-section" aria-labelledby="uploadHeading">
          <div class="section-intro">
            <h2 id="uploadHeading">Upload video</h2>
            <p>Add a source file to start a new edit.</p>
          </div>

          <div class="dropzone" id="dropzone">
            <input
              type="file"
              id="fileInput"
              accept=".mp4,.m4v,.mov,.mkv,.webm,.avi,.mpeg,.mpg,.3gp,video/*"
              hidden
            />
            <div class="dropzone-icon" aria-hidden="true">
              <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <rect x="4" y="9" width="32" height="22" rx="3" />
                <path d="M20 24V15m0 0-4 4m4-4 4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="dropzone-title">Drop a video here</div>
            <div class="dropzone-sub">MP4, MOV, MKV, WebM, AVI, M4V, MPEG, or 3GP</div>
            <button class="btn btn-choose" id="browseBtn" type="button">Browse files</button>
            <div class="dropzone-limits">Maximum 150 MB · 5 minutes · 1080p</div>
          </div>

          <div class="upload-progress hidden" id="uploadProgress" aria-live="polite">
            <div class="upload-progress-head">
              <span id="uploadStatusText">Uploading…</span>
              <span id="uploadPercent">0%</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill" id="uploadProgressFill"></div>
            </div>
          </div>
        </section>

        <section class="sidebar-section library-section" aria-labelledby="libraryHeading">
          <div class="library-head">
            <h2 id="libraryHeading">Library</h2>
            <span class="count-badge" id="libraryCount">0</span>
          </div>
          <div class="library-list" id="libraryList" aria-live="polite"></div>
          <div class="empty-state compact hidden" id="libraryEmpty">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <rect x="3" y="9" width="42" height="30" rx="3" />
              <path d="M19 18.5v11l9-5.5-9-5.5Z" fill="currentColor" stroke="none" />
            </svg>
            <p>No videos yet</p>
            <span>Upload a video to get started.</span>
          </div>
          <div class="inline-error hidden" id="libraryError" role="alert"></div>
        </section>

        <p class="sidebar-foot">
          Completed and failed jobs are removed from the server after 24 hours.
        </p>
      </aside>

      <section class="workspace">
        <div class="empty-state workspace-empty" id="workspaceEmpty">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
            <rect x="5" y="13" width="54" height="38" rx="4" />
            <path d="M26 24v16l13-8-13-8Z" fill="currentColor" stroke="none" />
          </svg>
          <p>Choose a video to start editing</p>
          <span>Upload a file or select one from the library to preview it and build a processing pipeline.</span>
        </div>

        <div class="workspace-content hidden" id="workspaceContent">
          <header class="workspace-head">
            <h1 id="workspaceTitle">—</h1>
            <p id="workspaceSub">—</p>
          </header>

          <div class="workspace-body">
            <section class="panel preview-panel" aria-label="Video preview">
              <div id="previewBody"></div>
            </section>

            <div class="work-grid">
              <section class="panel editor-panel" aria-label="Edit video">
                <div id="operationsBody"></div>
              </section>

              <section class="panel process-panel" aria-label="Processing status">
                <div id="jobBody"></div>
              </section>
            </div>
          </div>
        </div>
      </section>
    </main>

    <div class="toast-container" id="toastContainer" aria-live="polite"></div>

    <script src="/app.js"></script>
  </body>
</html>
